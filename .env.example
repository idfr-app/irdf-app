# ─────────────────────────────────────────────────────────────────────────────
# IRDF-APP environment. Copy to `.env.local` and fill in. Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — public values (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server only. The service role bypasses row-level security, so it
# must never reach the client and every query using it must scope the tenant
# explicitly. Keep this out of NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron protection. If set, /api/cron requires this as a bearer token or ?secret=.
CRON_SECRET=choose-a-long-random-string

# AI providers — OPTIONAL. If none are set, the AI router falls back to the
# deterministic template provider, so the product still runs end to end offline.
# The user's chosen provider per task is honoured when a key is present.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
